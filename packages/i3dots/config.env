# Configuración de Paquete: i3dots
# Este archivo es cargado por dots

# 1. Rutas y Directorios Base
export WALLPAPER_DIR="$HOME/wall"
export ROFI_THEME="$HOME/.config/rofi/themes/launcher.rasi"
export WALL_SEL_THEME="$HOME/.config/rofi/themes/WallSelect.rasi"

# Persistencia Local
export LAST_WALLPAPER_PATH_FILE="$HOME/.config/i3/wall"
export CURRENT_WALLPAPER_LINK="$HOME/.config/i3/current"

# Motor de wallpaper
export WP_ENGINE="live"

# Directorios de Lógica del Paquete
export HOOK_DIR="$PACKAGE_DIR/hooks"

# 2. Variantes y Componentes
if [ -f "$PACKAGE_DIR/.current_variant" ]; then
    VARIANT_NAME=$(cat "$PACKAGE_DIR/.current_variant")
    [ -f "$PACKAGE_DIR/distros/${VARIANT_NAME}/env" ] && source "$PACKAGE_DIR/distros/${VARIANT_NAME}/env"
fi
export SEQUENTIAL_COMPONENTS="icons"
export MANAGED_COMPONENTS="polybar i3 refresh"

# 3. Secuencias de Ejecución (DOT_SEQUENCES)
export DOT_SEQUENCE=(
    "wp_seq.sh"
)

export DOT_SEQUENCE_RELOAD=(
    "(polybar-msg cmd hide 2>/dev/null ; pkill -u $UID -x polybar) &"
    "engine_matugen.sh"
    "apply_dots.sh"
)

export DOT_SEQUENCE_DISPLAY=(
    "engine_display.sh"
)

export DOT_SEQUENCE_BAR=(
    "bar_menu.sh"
)

export DOT_SEQUENCE_WALLPAPER=(
    -c "wall_menu.sh"
)

export DOT_SEQUENCE_LIVE=(
    "wp_live_seq.sh"
)

export DOT_SEQUENCE_NETWORK=(
    "rofi_network.lua"
)

export DOT_SEQUENCE_WIFI=(
    "rofi_network.lua"
)


# 4. Configuración de Barra (Polybar)
export BAR_SEL_THEME="$HOME/.config/rofi/themes/shared/menu_generic.rasi"
export BAR_DEFAULT_TYPE="polybar_underline"
export BAR_STYLE="square"
export BAR_POSITION="bottom"
export BAR_TRANSPARENCY="false"
export BAR_HEIGHT="15pt"
export BAR_PRESETS="Pastillas: --type polybar_antigua | Flotante: --type polybar_floating --mode solid | Minimalista: --type polybar_underline --mode underline | Bloques: --type polybar_underline --mode solid | Compacto: --type polybar_compact"

# 5. Configuración de Live Wallpaper
# true: pausar video si hay cualquier ventana abierta (tiling)
# false: pausar video únicamente si la ventana está en pantalla completa (fullscreen)
export LIVE_WP_PAUSE_ON_WINDOW="true"

